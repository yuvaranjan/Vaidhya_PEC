# apps/web/.env.local — copy to .env.local and fill in. Never commit .env.local.
#
# NEXT_PUBLIC_* is exposed to the browser. Everything else stays server-side.
# ACTIAN_VECTORAI_TOKEN must never appear in a NEXT_PUBLIC_ var.

# --- node role: decides which portals this machine renders ------------
#   edge    = Node A, the village laptop  (patient + nurse)
#   central = Node B, the city laptop     (doctor + pharmacy + analytics)
NEXT_PUBLIC_NODE_ROLE=edge
NEXT_PUBLIC_JURISDICTION_ID=jur_thrissur_01

# --- the hour-8 switch ------------------------------------------------
# true  → canned responses from lib/mockAi.ts, no edge-ai needed
# false → real HTTP to NEXT_PUBLIC_EDGE_AI_URL
NEXT_PUBLIC_USE_MOCK_AI=false
NEXT_PUBLIC_EDGE_AI_URL=http://localhost:8000

# --- Actian VectorAI DB -----------------------------------------------
# REST API URL. Local VectorAI DB commonly exposes REST on :6573.
ACTIAN_VECTORAI_URL=http://localhost:6573
ACTIAN_VECTORAI_TOKEN=
ACTIAN_VECTORAI_COLLECTION_PREFIX=vaidhya_

# --- session cookie ---------------------------------------------------
# Must be at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=

# --- mqtt (doctor browser side of seam B) -----------------------------
NEXT_PUBLIC_MQTT_URL=wss://your-cluster.s1.eu.hivemq.cloud:8884/mqtt
NEXT_PUBLIC_MQTT_USERNAME=
NEXT_PUBLIC_MQTT_PASSWORD=

# --- groq (specialist AI, central node) -------------------------------
GROQ_API_KEY=
GROQ_SPECIALIST_MODEL=llama-3.3-70b-versatile

# --- tunables ---------------------------------------------------------
NEARBY_RADIUS_KM=15
CONSULT_TIMEOUT_SECONDS=45
