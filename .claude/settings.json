{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/update-progress.mjs --context",
            "timeout": 15,
            "statusMessage": "Loading the team progress board"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/update-progress.mjs --stop-hook",
            "timeout": 20,
            "statusMessage": "Updating the progress board"
          }
        ]
      }
    ]
  }
}
